page {
    includeCSS {
        theme = EXT:sv_bad_schwartau/Resources/Public/Scss/Theme/theme.scss
	custom = EXT:sv_bad_schwartau/Resources/Public/Css/custom.css
    }

    includeJSFooter {
        sv_bad_schwartau_scripts = EXT:sv_bad_schwartau/Resources/Public/JavaScript/main.js
    }
}

plugin.tx_ttaddress._LOCAL_LANG {
    default {
        label.telephone = Telefon
        label.email = E-Mail
    }
    de {
        label.telephone = Telefon
        label.email = E-Mail
    }
}
